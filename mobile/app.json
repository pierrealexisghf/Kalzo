{
  "expo": {
    "name": "Kalzo",
    "slug": "kalzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kalzo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fr.kalzo.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Kalzo utilise l'appareil photo pour photographier tes repas et estimer leurs valeurs nutritionnelles.",
        "NSPhotoLibraryUsageDescription": "Kalzo accède à ta photothèque pour que tu puisses choisir la photo d'un repas.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fr.kalzo.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d3b2a",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d3b2a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kalzo utilise l'appareil photo pour photographier tes repas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kalzo accède à ta photothèque pour que tu puisses choisir la photo d'un repas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0d3b2a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a67b2c5e-928e-46ed-a30f-968d39cc6a4d"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "pierrealexisghf",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a67b2c5e-928e-46ed-a30f-968d39cc6a4d"
    }
  }
}
